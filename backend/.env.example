OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o

# ----- ローカル開発 -----
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json
FIREBASE_CREDENTIALS_PATH=./credentials/service-account.json

# ----- 本番（Railway 等）: ファイルの代わりに JSON 文字列を設定 -----
# サービスアカウント JSON ファイルの中身をそのままコピー＆ペーストする
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

FIREBASE_PROJECT_ID=your-firebase-project-id
TEMPLATE_STORE_PATH=./data/templates
FALLBACK_CONFIDENCE_THRESHOLD=0.5
DEV_MODE=false

# CORS 許可オリジン（カンマ区切り）
# 本番では Railway フロントの URL を追加する
# CORS_ORIGINS=http://localhost:5173,https://your-frontend.railway.app
CORS_ORIGINS=http://localhost:5173
